cumhaz_Breslow1 = function(Time, event, Z, beta, w, eventcode)
{
# Set event =1 for the given event and =0 for all other events
eventcur = ifelse( event==eventcode, 1, 0)
# Find all unique deathpoints (sorted) for the given event
death_points_j = sort(unique(subset(Time, eventcur == 1)))
# Compute the exponential term of the Cox model for all subjects
coxexp = drop( exp( beta %*% t(Z) ) )
# For each deathpoint, compute the hazard rate (based on Breslow estimator)
di = sapply(death_points_j, function(x) sum( eventcur * as.numeric(Time == x) ) )
# denom = sapply(death_points_j, function(x) sum( as.numeric(Time >= x) * w * coxexp ) )
denom = sapply(death_points_j, function(x) sum( as.numeric( (Time > x) | (Time==x & event==1)  ) * w * coxexp ) )
lambda0_dp = di/denom
# For each data timepoint, compute hazard and cumulative hazard rate
Timef = as.numeric(levels(factor(Time)))
lambda0 = lambda0_dp[match(Timef,death_points_j,nomatch = NA)]
Lambda0 = sapply( seq(Timef), function(x) sum( as.numeric( death_points_j <= Timef[x] ) * lambda0_dp ) )
Lambda0 = Lambda0 * !(Timef < min(death_points_j))
# Return hazard rates
list(lambda0 = lambda0, Lambda0 = Lambda0)
}
# Fit Cox with no offset
DFbeta = data.table(Time,event,Z)
conv_w = 1e-3; conv_B = 1e-2; itermax_B = 100; itermax_w = 10; tau_b = 100; tau_beta = 100; verbose = T
# 1. Define some variables
n = length(event)
k = length(unique(event)) - 1
# if(is.null(mandI_ind)) mandI = NULL else mandI = colnames(cov)[mandI_ind]
if(is.null(mandI_ind)) mandI = NULL else mandI = c("Intercept",colnames(cov)[mandI_ind])
if(is.null(mandL_ind)) mandL = NULL else mandL = colnames(cov)[mandL_ind]
optI = setdiff(colnames(cov),mandI)
optL = setdiff(colnames(cov),mandL)
n_mandI = length(mandI); n_mandL = length(mandL); n_optI = length(optI); n_optL = length(optL);
# X = cov[,c(mandI,optI)]
if(is.null(mandI_ind)) X = cov[,c(mandI,optI)] else X = cbind(Intercept=1, cov[,c(mandI[-1],optI)])
Z = cov[,c(mandL,optL)]
Xmand = X[,mandI,drop=F]
Zmand = Z[,mandL,drop=F]
Xopt = X[,optI,drop=F]
Zopt = Z[,optL,drop=F]
delta = sapply(1:k, function(x) as.numeric(event==x))
b_nu = beta_nu = rep(0,k)
l_vecI = 1:n_mandI
l_vecL = 1:n_mandL
nu_vecI = 1:n_optI
nu_vecL = 1:n_optL
# 2. EM algorithm to estimate b (incidence param) and beta (latency param)
## 2.1 Set initial values
# w = matrix(event,n,k) #R recycles vectors when you create a matrix
w = ifelse( delta==1, 1, 0.5)   #more reasonable preliminary estimate of w
b = matrix(0, nrow = k, ncol = ncol(X), dimnames = list(1:k, colnames(X)))
beta = matrix(0, nrow = k, ncol = ncol(Z), dimnames = list(1:k, colnames(Z)))
## 2.2 run EM-Boosting loop
convergence_w = convergence_w_vec = 100
# loglike_w_vec = c() #loglike(p,beta,Z,delta,y=w,lambda0,Lambda0)
convergence_B_list = list()
M = 0
# if(verbose) cat("M =",M,": convergence_w =",convergence_w,"\n")
M = M + 1
######=> Perform expectation step (E-step) and check convergence
w_old = w
computed_w = compute_w(w, b, beta, Time, event, k, X, Z, delta)
w = computed_w$w
# w = sapply(1:k, function(i) smsurv(Time,1*(event==i),cbind(1,Z),beta[i,],w[,i],"ph")$survival)
convergence_w = sum( (w - w_old)^2 )
convergence_w_vec = c(convergence_w_vec,convergence_w)
if(verbose) cat("M =",M,"begins, convergence_w =",convergence_w,"\n")
# Fit Cox with no offset
DFbeta = data.table(Time,event,Z)
update_beta = t(sapply(1:k, function(i) eval(parse(text = paste("coxph(Surv(Time, 1*(event==",i,")) ~ ", paste(colnames(Z),collapse=" + "), ", data=DFbeta, subset=w1!=0, method='breslow')",sep = "")))$coef ))
i = 3
w1 = w[,i]
log_w1 = log(w1)
DFbeta = data.table(Time,event,Z)
i = 3
w1 = w[,i]
log_w1 = log(w1)
DFbeta = data.table(Time,event,Z)
# Get beta estimates
