compute_survival_info1 = function(Time=Time, event=event, k, Z=Z, beta=beta, w=w)
{
survinfo = lapply( 1:k, function(x) cumhaz_Breslow1(Time=Time, event=event, Z=Z, beta=beta[x,], w=w[,x], eventcode=x) )
Lambda0 = sapply(survinfo, function(x)x$Lambda0)
lambda0 = sapply(survinfo, function(x)x$lambda0)
s0 = exp(-Lambda0)
# s = s0 ^ exp(Z %*% t(beta))  # subject-specific survival rate for each cause
return( list(lambda0=lambda0, Lambda0=Lambda0, s0=s0) )  #, s=s
}
