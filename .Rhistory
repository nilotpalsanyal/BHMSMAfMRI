cumhaz_Breslow = function(Time, event, Z, beta, w, eventcode)
{
# Set event =1 for the given event and =0 for all other events
event = ifelse( event==eventcode, 1, 0)
# Find all unique deathpoints (sorted) for the given event
death_points_j = sort(unique(subset(Time, event == 1)))
# Compute the exponential term of the Cox model for all subjects
coxexp = drop( exp( beta %*% t(Z) ) )
# For each deathpoint, compute the hazard rate (based on Breslow estimator)
di = sapply(death_points_j, function(x) sum( event * as.numeric(Time == x) ) )
denom = sapply(death_points_j, function(x) sum( as.numeric( (Time > x) | (Time==x & event==1)  ) * w * coxexp ) )
lambda0_dp = di/denom
# For each data timepoint, compute hazard and cumulative hazard rate
lambda0 = lambda0_dp[match(Time,death_points_j,nomatch = NA)]
Lambda0 = sapply( seq(Time), function(x) sum( as.numeric( death_points_j <= Time[x] ) * lambda0_dp ) )
Lambda0 = Lambda0 * !(Time < min(death_points_j))
# Return hazard rates
list(lambda0 = lambda0, Lambda0 = Lambda0)
}
