?CSC
library(prodlim)
library(survival)
data(Melanoma)
## fit two cause-specific Cox models
## different formula for the two causes
fit1 <- CSC(list(Hist(time,status)~sex+age,Hist(time,status)~invasion+epicel+log(thick)),
data=Melanoma)
print(fit1)
## Not run:
library(Publish)
publish(fit1)
## End(Not run)
## model hazard of all cause mortality instead of hazard of type 2
fit1a <- CSC(list(Hist(time,status)~sex+age,Hist(time,status)~invasion+epicel+log(thick)),
data=Melanoma,
surv.type="surv")
#
names(fit1a)
fit1a$fitter
fit1a$models
names(fit1a$models)
names(fit1a$models$`Cause 1`)
names(fit1a$models$`Cause 1`)
fit1a$models$`Cause 1`$method
fit1 <- CSC(list(Hist(time,status)~sex+age,data=Melanoma),surv.type = "hazard")
fit1 <- CSC(list(Hist(time,status)~sex+age),surv.type = "hazard",data=Melanoma)
fit1$models$`Cause 1`$method
names(fit1$models$`Cause 1`)
